#floating-reg-button{
	top: 50vh;
	right:-8rem;
	z-index:10000;
	.transition();
	&:hover{
		right:1rem;
	}


	a{
		background: ~"rgba(var(--color), .5)";
		.shadow(0,0,1rem,rgba(0,0,0,.25));
		border:.4rem solid rgba(255,255,255,.5);
		backdrop-filter: blur(.5rem);
		.transition();
		&:hover{
			.opacity(1);
			//padding:1.8rem;
		}
	}
}

////

@media(max-width:800px){
	#floating-reg-button{
		top: 80vh;
		right:0rem;
	}
}