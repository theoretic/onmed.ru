$(function(){

		$(".comparator input[type=range]").on('input', function(e){

			let
				targetEl=$(e.target),
				comparatorEl = targetEl.parents(".comparator").first()

			comparatorEl.css( '--maskWidth', targetEl.val()+'%' )
		})

})